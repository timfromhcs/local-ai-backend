{
  // Project-local OpenCode config.
  // MCP servers are NOT redefined here on purpose: the previous version set every
  // server to { "command": ["true"], "enabled": false }. OpenCode still tried to
  // start them, `true` does not exist on Windows, and every server reported
  // "MCP server process exited with code 1" (github, playwright, ast-grep, fetch,
  // memory, sequential-thinking, blender, system-one-jev). Omitting the `mcp` key
  // lets the global config (real commands, real tokens) apply again.
  //
  // Port 18090 is outside the supervisor range 18100-18199 and the Jev server port 8080.
  // NOTE: only ONE model can stay resident next to a 9 GB model. If you want the
  // shortest possible prompt for the local 27B, start OpenCode with a dedicated
  // profile instead of silently breaking MCPs.
  "$schema": "https://opencode.ai/config.json",
  "model": "bonsai/bonsai-27b",
  "small_model": "bonsai/bonsai-27b",
  "plugins": [],
  "providers": {
    "bonsai": {
      "package": "@ai-sdk/openai-compatible",
      "name": "Bonsai-27B (local llama.cpp Vulkan)",
      "settings": { "baseURL": "http://127.0.0.1:18090/v1", "apiKey": "local" },
      "models": {
        "bonsai-27b": {
          "name": "Bonsai 2 27B (local)",
          "limit": { "context": 16384, "output": 2048 }
        }
      }
    }
  }
}
