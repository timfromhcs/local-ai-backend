                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/v1/autotune": {
      "get": {
        "description": "Device-aware llama.cpp flags for one registered model.",
        "operationId": "autotune_v1_autotune_get",
        "parameters": [
          {
            "in": "query",
            "name": "model",
            "required": true,
            "schema": {
              "title": "Model",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ctx",
            "required": false,
            "schema": {
              "default": 16384,
              "title": "Ctx",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Autotune"
      }
    },
    "/v1/bench": {
      "post": {
        "description": "Run the deterministic fast/long suite against one model. Scoring has no LLM judge.",
        "operationId": "bench_v1_bench_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
