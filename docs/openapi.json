    "/v1/placement": {
      "get": {
        "description": "SAT-based answer to \"which models fit in RAM at the same time\".",
        "operationId": "placement_v1_placement_get",
        "parameters": [
          {
            "in": "query",
            "name": "budget_mb",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Budget Mb"
            }
          },
          {
            "in": "query",
            "name": "kinds",
            "required": false,
            "schema": {
              "default": "llm",
              "title": "Kinds",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "pinned",
            "required": false,
            "schema": {
              "default": "",
              "title": "Pinned",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Placement"
      }
    },
