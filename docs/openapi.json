  "openapi": "3.1.0",
  "paths": {
    "/doctor": {
      "get": {
        "description": "Same report as `localai-gateway --doctor`, as JSON.",
        "operationId": "doctor_route_doctor_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Doctor Route"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
